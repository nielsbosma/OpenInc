# Copy to .env for `pnpm dev`. Values match docker-compose.yml (pnpm infra:up).
# Production needs only these too; everything else is set in Admin settings.
DATABASE_URL=postgres://openinc:openinc@localhost:5470/openinc
S3_ENDPOINT=http://localhost:9300
S3_BUCKET=openinc
S3_ACCESS_KEY=openinc
S3_SECRET_KEY=openinc-secret
S3_REGION=us-east-1
APP_SECRET=dev-only-secret-do-not-use-in-production-0123456789
APP_URL=http://localhost:5173

# Optional, in .env.local (gitignored): the seed copies a real AI key into Admin settings.
# SEED_AI_PROVIDER=anthropic
# SEED_AI_MODEL=claude-sonnet-5-5
# SEED_AI_API_KEY=
