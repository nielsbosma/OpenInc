{
  "name": "openinc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@openinc/server --filter=@openinc/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @openinc/web exec playwright test",
    "storybook": "pnpm --filter @openinc/web storybook",
    "infra:up": "docker compose up -d --wait postgres s3 mailpit && docker compose run --rm s3-init",
    "infra:down": "docker compose down",
    "db:generate": "pnpm --filter @openinc/db generate",
    "db:migrate": "pnpm --filter @openinc/db migrate",
    "db:reset": "pnpm --filter @openinc/core reset"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26",
    "turbo": "^2.11.9",
    "typescript": "^6"
  }
}
